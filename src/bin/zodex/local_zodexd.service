[Unit]
Description=Zodex Local agent daemon
After=zodex-local-network.service zodex-prd.service
Requires=zodex-local-network.service zodex-prd.service

[Service]
Type=simple
User=zodex-agent
Group=zodex
NetworkNamespacePath=/run/netns/zodex-agent
BindReadOnlyPaths=/etc/netns/zodex-agent/resolv.conf:/etc/resolv.conf
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ExecStart=/usr/local/bin/zodexd --config /etc/zodex/config.toml
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
