{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "ignoreCommand": "node scripts/should-build.mjs",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  }
}
